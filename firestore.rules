rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // Perfiles y dispositivos propios del usuario
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /dispositivos/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Registro del nodo central activo del sitio
    match /nodos_activos/{siteId} {
      allow read: if isAuthenticated();
      // Solo admin puede reemplazar el nodo activo si ya existe
      allow write: if isAuthenticated() && (isAdmin() || request.auth.uid == request.resource.data.userId);
    }

    // Sitios y perímetros de bodega
    match /sitios/{siteId} {
      allow read: if isAuthenticated();

      // Validación de escritura: solo campos permitidos y comprobación de admin para horario/PIN
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        // Si no se modifica horario ni PIN, operadores pueden actualizar estado de actuadores/sensores
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['horario', 'pinHash', 'pinSalt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Registro inmutable de eventos de seguridad (ISO/IEC 27400: integridad de logs)
      match /eventos/{id} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.tipo is string &&
          request.resource.data.detalle is string &&
          request.resource.data.origen is string;
        // Los eventos NO se pueden editar ni borrar
        allow update, delete: if false;
      }

      match /config/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      match /sensores/{docId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
